# =====================================================================
# Verônica Vargas Semijoias — configuração para hospedagem Apache
# (Hostinger, HostGator, cPanel em geral)
# =====================================================================
# Este arquivo é o equivalente do netlify.toml. O Netlify o ignora, então
# pode ficar aqui sem atrapalhar: quem estiver servindo o site usa o seu.
#
# Como usar: envie o conteúdo do repositório para dentro de public_html —
# o conteúdo, não a pasta. O index.html precisa ficar direto em
# public_html/, e este arquivo ao lado dele.
#
# O banco de dados não é afetado por nada disto. Ele fica no Supabase, um
# serviço à parte, e é o navegador do visitante que fala com ele.
# =====================================================================

RewriteEngine On

# ---------------------------------------------------------------------
# 1. HTTPS obrigatório
#    Sem cadeado o navegador bloqueia a área administrativa (o login usa
#    recursos de criptografia que só funcionam em conexão segura) e o
#    Google penaliza o site. Ative o SSL gratuito no painel primeiro.
# ---------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------
# 2. Endereços das categorias
#    /categoria/aneis e /catalogo não são pastas de verdade: entregam o
#    mesmo index.html, e o JavaScript abre a vista certa. Sem esta regra
#    esses endereços dariam 404 — e são eles que o Google indexa.
# ---------------------------------------------------------------------
RewriteRule ^categoria/[a-z0-9-]+/?$ /index.html [L]
RewriteRule ^catalogo/?$ /index.html [L]

# ---------------------------------------------------------------------
# 3. Material interno fora do ar
#    Nada aqui tem senha, mas também não precisa ficar acessível.
# ---------------------------------------------------------------------
RedirectMatch 404 ^/supabase/
RedirectMatch 404 ^/copy-semi-joias\.txt$
RedirectMatch 404 ^/design-system-veronica-vargas\.html$
RedirectMatch 404 ^/assets/LEIA-ME\.md$
RedirectMatch 404 ^/assets/originais/

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 4. Cabeçalhos de segurança
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # As fontes viajam em modo CORS mesmo vindo do próprio site
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # A página busca conteúdo do Supabase: nunca pode ficar em cache longo
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 5. Cache das mídias — trocam de nome quando mudam
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4   "access plus 1 year"
  ExpiresByType font/woff2  "access plus 1 year"
  ExpiresDefault "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------------------
# 6. Compressão
#    O HTML tem 200 KB e comprime para perto de 60 KB.
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 7. Tipos que algumas hospedagens não conhecem
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
